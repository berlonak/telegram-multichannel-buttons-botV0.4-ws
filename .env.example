# Token from @BotFather
BOT_TOKEN=123456789:PASTE_YOUR_TELEGRAM_BOT_TOKEN

# Telegram IDs of global bot owners, comma-separated.
# Owners can manage all channels and users.
OWNER_IDS=123456789

# true: a user can connect a channel if they are admin of that channel.
# false: only OWNER_IDS can connect channels.
ALLOW_SELF_ADD_CHANNELS=true

# SQLite database. Keep it on a persistent volume in production.
DATABASE_PATH=data/bot.sqlite3

# Draft preview lifetime before cleanup.
PREVIEW_TTL_HOURS=24

# Optional runtime settings.
LOG_LEVEL=INFO
API_TIMEOUT=35
POLL_TIMEOUT=25
